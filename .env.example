# Copy this file to .env and fill in your key. .env is ignored by git.
OPENAI_API_KEY=

# The model the benchmark used. Change it only if this endpoint is unavailable,
# and say so on stage: the published LLM results are for gpt-5.6-luna.
LLM_MODEL=gpt-5.6-luna

# Only needed for an OpenAI-compatible endpoint other than api.openai.com.
OPENAI_BASE_URL=
